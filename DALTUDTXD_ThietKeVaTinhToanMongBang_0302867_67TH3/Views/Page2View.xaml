<UserControl x:Class="DALTUDTXD_ThietKeVaTinhToanMongBang_0302867_67TH3.Views.Page2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DALTUDTXD_ThietKeVaTinhToanMongBang_0302867_67TH3.Views"
             xmlns:vm="clr-namespace:DALTUDTXD_ThietKeVaTinhToanMongBang_0302867_67TH3.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <vm:CenterConverter x:Key="CenterConverter"/>
        <vm:TextPositionConverter x:Key="TextPositionConverter"/>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Nhập thông số móng" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="8">
                        <TextBlock Text="Tên móng" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding FoundationNames}"
                                  SelectedValue="{Binding NewConstructionEntry.TenMong, Mode=TwoWay}"
                                  IsEditable="True" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8">
                        <TextBlock Text="Chiều sâu chôn móng (m)" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <TextBox Text="{Binding ChieuSauChonMongProxy, Mode=TwoWay}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="8">
                        <TextBlock Text="Chiều rộng móng (m)" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <TextBox Text="{Binding ChieuRongMongProxy, Mode=TwoWay}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="8">
                        <TextBlock Text="Chiều cao đài (m)" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <TextBox Text="{Binding ChieuCaoDaiProxy, Mode=TwoWay}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="8">
                        <TextBlock Text="Cấp độ bê tông" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <ComboBox ItemsSource="{Binding DanhSachCapDoBeTong}"
                                  SelectedValue="{Binding NewConstructionEntry.CapDoBeTong, Mode=TwoWay}"
                                  Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8">
                        <TextBlock Text="Loại thép" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <ComboBox ItemsSource="{Binding DanhSachLoaiThep}"
                                  SelectedValue="{Binding NewConstructionEntry.LoaiThep, Mode=TwoWay}"
                                  Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="8">
                        <TextBlock Text="Chiều dày lớp bảo vệ (mm)" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding NewConstructionEntry.ChieuDayLopBaoVe, Mode=TwoWay}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8">
                        <TextBlock Text="Bề dày tường (m)" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding BeDayTuongProxy, Mode=TwoWay}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Grid.RowSpan="3">
                        <TextBlock Text="Mô phỏng sơ bộ" HorizontalAlignment="Center" Margin="0,0,0,5"
                                   Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                        <Canvas Width="300" Height="250" Background="{StaticResource CanvasBackgroundBrush}" ClipToBounds="True"
                                x:Name="ViewportCanvas"
                                MouseWheel="Viewport_MouseWheel"
                                MouseRightButtonDown="Viewport_MouseRightButtonDown"
                                MouseRightButtonUp="Viewport_MouseRightButtonUp"
                                MouseMove="Viewport_MouseMove">

                            <Canvas x:Name="DrawingCanvas">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="TranslateTf" X="0" Y="0"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <Line X1="0" Y1="{Binding GroundLevelLineTopPx}" X2="300" Y2="{Binding GroundLevelLineTopPx}"
                                      Stroke="{StaticResource plainTextColor1Brush}" StrokeThickness="1" StrokeDashArray="2 2"/>

                                <TextBlock Text="Mặt đất tự nhiên" Foreground="{StaticResource plainTextColor1Brush}" FontSize="11"
                                           Canvas.Left="5"
                                           Canvas.Top="{Binding GroundLevelLineTopPx, Converter={StaticResource TextPositionConverter}}"/>

                                <Rectangle Fill="#78716C" Stroke="#57534E" StrokeThickness="1"
                                           Width="{Binding WallWidthPx}" Height="{Binding WallHeightPx}"
                                           Canvas.Left="{Binding WallWidthPx, Converter={StaticResource CenterConverter}}"
                                           Canvas.Top="{Binding WallTopPx}"/>

                                <Rectangle Fill="{StaticResource ShellAccentBrush}" Stroke="#D97706" StrokeThickness="1"
                                           Width="{Binding MongWidthPx}" Height="{Binding DaiHeightPx}"
                                           Canvas.Left="{Binding MongWidthPx, Converter={StaticResource CenterConverter}}"
                                           Canvas.Top="{Binding DaiTopPx}"/>
                            </Canvas>
                        </Canvas>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                    <Button Content="Xác nhận" Command="{Binding AddConstructionCommand}"
                            Padding="20,10" Style="{StaticResource PrimaryButton}" Background="{StaticResource color9Brush}"/>
                    <Button Content="Xóa" Command="{Binding DeleteConstructionCommand}" Margin="10 0 0 0"
                            Padding="20,10" Style="{StaticResource PrimaryButton}" Background="#DC2626"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Danh sách thông số" Style="{StaticResource SectionTitle}"
                           Grid.Row="0" Margin="5" HorizontalAlignment="Center"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding ConstructionList}"
                          SelectedItem="{Binding SelectedConstructionEntry, Mode=TwoWay}"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên móng" Binding="{Binding TenMong}" Width="1.2*"/>
                        <DataGridTextColumn Header="Sâu chôn (m)" Binding="{Binding ChieuSauChonMong}" Width="*"/>
                        <DataGridTextColumn Header="Rộng móng (m)" Binding="{Binding ChieuRongMong}" Width="*"/>
                        <DataGridTextColumn Header="Bê tông" Binding="{Binding CapDoBeTong}" Width="0.8*"/>
                        <DataGridTextColumn Header="Loại thép" Binding="{Binding LoaiThep}" Width="0.8*"/>
                        <DataGridTextColumn Header="Lớp BV (mm)" Binding="{Binding ChieuDayLopBaoVe}" Width="*"/>
                        <DataGridTextColumn Header="Tường (m)" Binding="{Binding BeDayTuong}" Width="*"/>
                        <DataGridTextColumn Header="Cao đài (m)" Binding="{Binding ChieuCaoDai}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
