<UserControl x:Class="DALTUDTXD_ThietKeVaTinhToanMongBang_0302867_67TH3.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel>

        <!-- Hero -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Thiết kế móng băng" FontSize="26" FontWeight="Bold"
                               FontFamily="Segoe UI" Foreground="{StaticResource titleColor1Brush}"/>
                    <TextBlock Text="Hỗ trợ tính toán theo tiêu chuẩn Việt Nam"
                               FontSize="14" FontFamily="Segoe UI"
                               Foreground="{StaticResource ShellAccentBrush}" Margin="0,6,0,14"/>
                    <TextBlock Text="Nhập số liệu địa chất, thông số móng và nội lực để tính kích thước, cốt thép và kiểm tra điều kiện làm việc."
                               FontSize="13" FontFamily="Segoe UI"
                               Foreground="{StaticResource plainTextColor1Brush}"
                               TextWrapping="Wrap" MaxWidth="480" LineHeight="22"/>
                </StackPanel>

                <Image Grid.Column="1" Source="/Images/logo.png" Width="100" Height="100"
                       Margin="20,0,0,0" Opacity="0.85"/>
            </Grid>
        </Border>

        <!-- Steps grid -->
        <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="02" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource ShellAccentBrush}" Opacity="0.5"/>
                    <TextBlock Text="Số liệu nền đất" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource titleColor1Brush}" Margin="0,4,0,6"/>
                    <TextBlock Text="Nhập lớp đất, thông số địa chất và biểu đồ trục."
                               FontSize="12" Foreground="{StaticResource plainTextColor1Brush}"
                               TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="4,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="03" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource ShellAccentBrush}" Opacity="0.5"/>
                    <TextBlock Text="Thông số móng" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource titleColor1Brush}" Margin="0,4,0,6"/>
                    <TextBlock Text="Khai báo kích thước, bê tông, thép và mô phỏng."
                               FontSize="12" Foreground="{StaticResource plainTextColor1Brush}"
                               TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="05" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource ShellAccentBrush}" Opacity="0.5"/>
                    <TextBlock Text="Tính toán &amp; Báo cáo" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource titleColor1Brush}" Margin="0,4,0,6"/>
                    <TextBlock Text="Nhập nội lực, tính cốt thép và xuất báo cáo."
                               FontSize="12" Foreground="{StaticResource plainTextColor1Brush}"
                               TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border CornerRadius="8" Padding="14,10"
                Background="#292524" BorderBrush="{StaticResource winBorderColor1Brush}" BorderThickness="1">
            <TextBlock Text="Chọn bước trong menu bên trái để bắt đầu thiết kế."
                       FontSize="13" FontFamily="Segoe UI"
                       Foreground="{StaticResource plainTextColor1Brush}" HorizontalAlignment="Center"/>
        </Border>
    </StackPanel>
</UserControl>
