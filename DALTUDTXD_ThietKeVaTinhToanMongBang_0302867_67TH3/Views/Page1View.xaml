<UserControl x:Class="DALTUDTXD_ThietKeVaTinhToanMongBang_0302867_67TH3.Views.Page1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DALTUDTXD_ThietKeVaTinhToanMongBang_0302867_67TH3.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="Thông số địa chất" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>

                    <UniformGrid Columns="3">
                        <StackPanel Margin="5">
                            <TextBlock Text="STT Lớp" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewEntry.Sothutulopdat}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Số hiệu ĐC" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewEntry.Sohieudiachat}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Tên lớp đất" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewEntry.Tenlopdat}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Chiều dày (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewEntry.Chieudaylopdat}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Khối lượng TN" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewEntry.Khoiluongtunhien}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Góc ma sát (°)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewEntry.Gocmasattrong}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Lực dính (kPa)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewEntry.Lucdinhket}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Mô đun (MPa)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewEntry.Modunbiendang}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Vị trí móng" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewEntry.Vitrimong}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,5">
                        <Button Content="Thêm vào bảng" Command="{Binding AddFoundationCommand}" Style="{StaticResource PrimaryButton}" Width="160"/>
                        <Button Content="Lưu trục" Command="{Binding SaveGeologicalAxisCommand}" Style="{StaticResource PrimaryButton}" Background="{StaticResource color9Brush}" Margin="12,0,0,0" Width="160"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource CanvasBackgroundBrush}" CornerRadius="12" Margin="0,0,0,0"
                    BorderBrush="{StaticResource winBorderColor1Brush}" BorderThickness="1">
                <Grid ClipToBounds="True">
                    <TextBlock Text="BIỂU ĐỒ TRỤC ĐỊA CHẤT" HorizontalAlignment="Center" VerticalAlignment="Top" 
                               Margin="10" Foreground="{StaticResource plainTextColor1Brush}" FontWeight="SemiBold" FontSize="11" Panel.ZIndex="10"/>

                    <Canvas x:Name="ViewportCanvas" Background="Transparent"
                            MouseWheel="Viewport_MouseWheel"
                            MouseRightButtonDown="Viewport_MouseRightButtonDown"
                            MouseRightButtonUp="Viewport_MouseRightButtonUp"
                            MouseMove="Viewport_MouseMove">

                        <ItemsControl ItemsSource="{Binding FoundationList}">
                            <ItemsControl.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="MainScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="MainTranslate" X="50" Y="50"/>
                                </TransformGroup>
                            </ItemsControl.RenderTransform>

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="100"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Top" Value="{Binding RenderTop}"/>
                                    <Setter Property="Canvas.Left" Value="0"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Rectangle Width="100" Height="{Binding RenderHeight}" 
                                                   Fill="{Binding SoilColor}" Stroke="#CBD5E1" StrokeThickness="0.5"/>

                                        <Rectangle Width="100" Height="{Binding RenderHeight}" Opacity="0.1">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                                    <GradientStop Color="Black" Offset="0"/>
                                                    <GradientStop Color="Transparent" Offset="0.5"/>
                                                    <GradientStop Color="White" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Sohieudiachat}" Foreground="White" 
                                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Chieudaylopdat, StringFormat={}{0}m}" 
                                                       Foreground="White" FontSize="9" HorizontalAlignment="Center" Opacity="0.8"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding FoundationList}" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Binding="{Binding Sothutulopdat}" Width="50"/>
                    <DataGridTextColumn Header="Số hiệu ĐC" Binding="{Binding Sohieudiachat}" Width="80"/>
                    <DataGridTextColumn Header="Tên lớp đất" Binding="{Binding Tenlopdat}" Width="120"/>
                    <DataGridTextColumn Header="Chiều dày" Binding="{Binding Chieudaylopdat}" Width="80"/>
                    <DataGridTextColumn Header="Khối lượng TN" Binding="{Binding Khoiluongtunhien}" Width="100"/>
                    <DataGridTextColumn Header="Góc ma sát" Binding="{Binding Gocmasattrong}" Width="90"/>
                    <DataGridTextColumn Header="Lực dính kết" Binding="{Binding Lucdinhket}" Width="90"/>
                    <DataGridTextColumn Header="Mô đun BD" Binding="{Binding Modunbiendang}" Width="90"/>
                    <DataGridTextColumn Header="Vị trí móng" Binding="{Binding Vitrimong}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
