<Window x:Class="DALTUDTXD_ThietKeVaTinhToanMongBang_0302867_67TH3.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SF Cal - Thiết kế móng băng"
        Height="760"
        Width="1340"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border CornerRadius="10" Background="{StaticResource ShellBackgroundBrush}"
            BorderBrush="{StaticResource winBorderColor1Brush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource ShellSidebarBrush}"
                    CornerRadius="10,0,0,10"
                    BorderBrush="{StaticResource winBorderColor1Brush}"
                    BorderThickness="0,0,1,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Margin="20,20,20,24"
                                MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8"
                                    Background="#292524" Margin="0,0,12,0">
                                <Image Source="/Images/engineering.png" Width="26" Height="26"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SF CAL" FontSize="17" FontWeight="Bold"
                                           FontFamily="Segoe UI" Foreground="{StaticResource titleColor1Brush}"/>
                                <TextBlock Text="Móng băng" FontSize="11" FontFamily="Segoe UI"
                                           Foreground="{StaticResource ShellAccentBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Menu -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="QUY TRÌNH" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource plainTextColor1Brush}"
                                   Margin="22,0,0,8" Opacity="0.7"/>

                        <RadioButton Style="{StaticResource sidebarMenuButton}" IsChecked="True"
                                     GroupName="MainMenu" Command="{Binding ShowHomeViewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="01" Foreground="{StaticResource ShellAccentBrush}"
                                           FontWeight="Bold" FontSize="11" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Trang chủ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource sidebarMenuButton}" GroupName="MainMenu"
                                     Command="{Binding ShowCal1ViewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="02" Foreground="{StaticResource ShellAccentBrush}"
                                           FontWeight="Bold" FontSize="11" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Nền đất" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource sidebarMenuButton}" GroupName="MainMenu"
                                     Command="{Binding ShowCal2ViewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="03" Foreground="{StaticResource ShellAccentBrush}"
                                           FontWeight="Bold" FontSize="11" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Thông số móng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource sidebarMenuButton}" GroupName="MainMenu"
                                     Command="{Binding ShowCal3ViewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="04" Foreground="{StaticResource ShellAccentBrush}"
                                           FontWeight="Bold" FontSize="11" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Tải trọng" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource sidebarMenuButton}" GroupName="MainMenu"
                                     Command="{Binding ShowCal4ViewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="05" Foreground="{StaticResource ShellAccentBrush}"
                                           FontWeight="Bold" FontSize="11" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Tính toán" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource sidebarMenuButton}" GroupName="MainMenu"
                                     Command="{Binding ShowCal5ViewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="06" Foreground="{StaticResource ShellAccentBrush}"
                                           FontWeight="Bold" FontSize="11" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Báo cáo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Footer -->
                    <Border Grid.Row="2" Margin="16,0,16,16" Padding="12,10"
                            Background="#292524" CornerRadius="8">
                        <TextBlock Text="TCVN 5574:2018" FontSize="11" FontFamily="Segoe UI"
                                   Foreground="{StaticResource plainTextColor1Brush}" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Background="{StaticResource ShellHeaderBrush}"
                        BorderBrush="{StaticResource winBorderColor1Brush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown">
                    <Grid Margin="20,0,8,0">
                        <TextBlock Text="{Binding Caption}" FontSize="15" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" Foreground="{StaticResource titleColor1Brush}"
                                   VerticalAlignment="Center"/>

                        <StackPanel x:Name="pnlControlBar" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    MouseEnter="pnlControlBar_MouseEnter">
                            <Button x:Name="btnMinimize" Content="─" Style="{StaticResource controlButton}"
                                    Click="btnMinimize_Click" FontSize="11"/>
                            <Button x:Name="btnMaximize" Content="□" Style="{StaticResource controlButton}"
                                    Click="btnMaximize_Click" FontSize="11"/>
                            <Button x:Name="btnClose" Content="✕" Style="{StaticResource closeButton}"
                                    Click="btnClose_Click" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                    <ContentControl Content="{Binding CurrentChildView}"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
