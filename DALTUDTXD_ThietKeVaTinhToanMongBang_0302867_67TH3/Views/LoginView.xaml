<Window x:Class="DALTUDTXD_ThietKeVaTinhToanMongBang_0302867_67TH3.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Đăng nhập - SF Cal"
        Height="520"
        Width="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="14" Background="{StaticResource ShellBackgroundBrush}"
            BorderBrush="{StaticResource winBorderColor1Brush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,10,0">
                <Button x:Name="btnMinimize" Content="─" Style="{StaticResource controlButton}"
                        Click="btnMinimize_Click" FontSize="11"/>
                <Button x:Name="btnClose" Content="✕" Style="{StaticResource closeButton}"
                        Click="btnClose_Click" FontSize="11"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="36,0,36,36" VerticalAlignment="Center">

                <Border Width="72" Height="72" CornerRadius="36"
                        Background="#292524" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Image Source="/Images/engineering.png" Width="44" Height="44"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="SF CAL" FontSize="28" FontWeight="Bold" FontFamily="Segoe UI"
                           Foreground="{StaticResource titleColor1Brush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Thiết kế móng băng" FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource plainTextColor1Brush}"
                           HorizontalAlignment="Center" Margin="0,4,0,28"/>

                <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabel}"/>
                <Border Height="42" Margin="0,0,0,14"
                        Background="{StaticResource InputBackgroundBrush}"
                        CornerRadius="8"
                        BorderBrush="{StaticResource winBorderColor1Brush}" BorderThickness="1">
                    <Grid>
                        <Image Source="/Images/user.png" Width="16" Height="16"
                               VerticalAlignment="Center" Margin="12,0,0,0" HorizontalAlignment="Left" Opacity="0.6"/>
                        <TextBox x:Name="txtUser" FontSize="14" FontFamily="Segoe UI"
                                 Foreground="{StaticResource titleColor1Brush}"
                                 CaretBrush="{StaticResource ShellAccentBrush}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Padding="36,0,12,0"/>
                    </Grid>
                </Border>

                <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}"/>
                <Border Height="42" Margin="0,0,0,6"
                        Background="{StaticResource InputBackgroundBrush}"
                        CornerRadius="8"
                        BorderBrush="{StaticResource winBorderColor1Brush}" BorderThickness="1">
                    <Grid>
                        <Image Source="/Images/lock.png" Width="16" Height="16"
                               VerticalAlignment="Center" Margin="12,0,0,0" HorizontalAlignment="Left" Opacity="0.6"/>
                        <PasswordBox x:Name="txtPassword" FontSize="14" FontFamily="Segoe UI"
                                     Foreground="{StaticResource titleColor1Brush}"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Padding="36,0,12,0"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="txtError" Foreground="#F87171" FontSize="12"
                           FontFamily="Segoe UI" Margin="4,4,0,0"/>

                <Button x:Name="btnLogin" Content="ĐĂNG NHẬP" Style="{StaticResource loginButton}"
                        Margin="0,22,0,0" Click="btnLogin_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="Quên mật khẩu?" FontSize="12" FontFamily="Segoe UI"
                               Foreground="{StaticResource plainTextColor1Brush}"/>
                    <TextBlock Text=" Khôi phục" FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold"
                               Foreground="{StaticResource ShellAccentBrush}" Cursor="Hand"
                               MouseLeftButtonDown="Reset_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
